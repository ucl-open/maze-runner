{
  "$defs": {
    "BackgroundSubtractionParemeters": {
      "properties": {
        "thresholdValue": {
          "title": "ThresholdValue",
          "type": "number"
        },
        "backgroundFrames": {
          "title": "BackgroundFrames",
          "type": "integer"
        },
        "adaptationRate": {
          "title": "AdaptationRate",
          "type": "number"
        }
      },
      "required": [
        "thresholdValue",
        "backgroundFrames",
        "adaptationRate"
      ],
      "title": "BackgroundSubtractionParemeters",
      "type": "object"
    },
    "CameraTriggerController": {
      "description": "Represents a CameraTriggerController module on a BehaviorBoard device.",
      "properties": {
        "trigger0Frequency": {
          "description": "The frequency, in Hz, at which to emit camera triggers on Trigger0 (DO0, CameraOutput0)",
          "examples": [
            "50"
          ],
          "title": "Trigger0Frequency",
          "type": "integer"
        },
        "trigger1Frequency": {
          "description": "The frequency, in Hz, at which to emit camera triggers on Trigger1 (DO1, CameraOutput1)",
          "examples": [
            "50"
          ],
          "title": "Trigger1Frequency",
          "type": "integer"
        }
      },
      "required": [
        "trigger0Frequency",
        "trigger1Frequency"
      ],
      "title": "CameraTriggerController",
      "type": "object"
    },
    "ExperimentSession": {
      "description": "The base class for creating open-rigs experiment models.",
      "properties": {
        "workflow": {
          "description": "Path to the workflow running the experiment.",
          "title": "Workflow",
          "type": "string"
        },
        "commit": {
          "description": "Commit hash of the experiment repo.",
          "title": "Commit",
          "type": "string"
        },
        "repositoryUrl": {
          "description": "The URL of the git repository used to version experiment source code.",
          "title": "RepositoryUrl",
          "type": "string"
        },
        "subjectId": {
          "description": "The subject id for this session.",
          "title": "SubjectId",
          "type": "string"
        },
        "sessionId": {
          "description": "The session identifier.",
          "title": "SessionId",
          "type": "string"
        }
      },
      "required": [
        "workflow",
        "commit",
        "repositoryUrl",
        "subjectId",
        "sessionId"
      ],
      "title": "ExperimentSession",
      "type": "object"
    },
    "FindContoursParameters": {
      "properties": {
        "minArea": {
          "title": "MinArea",
          "type": "number"
        }
      },
      "required": [
        "minArea"
      ],
      "title": "FindContoursParameters",
      "type": "object"
    },
    "HarpBehavior": {
      "properties": {
        "portName": {
          "description": "The name of the device serial port.",
          "examples": [
            "COM"
          ],
          "title": "PortName",
          "type": "string"
        }
      },
      "required": [
        "portName"
      ],
      "title": "HarpBehavior",
      "type": "object"
    },
    "OpenRigsMazeRunnerRig": {
      "properties": {
        "rootPath": {
          "description": "The root path on which to log all data.",
          "title": "RootPath",
          "type": "string"
        },
        "camera": {
          "$ref": "#/$defs/SpinnakerCamera",
          "title": "Camera"
        },
        "behaviorBoard": {
          "$ref": "#/$defs/HarpBehavior",
          "title": "BehaviorBoard"
        },
        "cameraTriggerController": {
          "$ref": "#/$defs/CameraTriggerController"
        },
        "initialBackgroundSubtraction": {
          "$ref": "#/$defs/BackgroundSubtractionParemeters",
          "title": "InitialBackgroundSubtraction"
        },
        "onlineBackgroundSubtraction": {
          "$ref": "#/$defs/BackgroundSubtractionParemeters",
          "title": "OnlineBackgroundSubtraction"
        },
        "animalContourParameters": {
          "$ref": "#/$defs/FindContoursParameters",
          "title": "AnimalContourParameters"
        }
      },
      "required": [
        "rootPath",
        "camera",
        "behaviorBoard",
        "cameraTriggerController",
        "initialBackgroundSubtraction",
        "onlineBackgroundSubtraction",
        "animalContourParameters"
      ],
      "title": "OpenRigsMazeRunnerRig",
      "type": "object"
    },
    "OpenRigsMazeRunnerTaskLogic": {
      "properties": {
        "taskParameters": {
          "$ref": "#/$defs/OpenRigsMazeRunnerTaskParameters",
          "title": "TaskParameters"
        }
      },
      "required": [
        "taskParameters"
      ],
      "title": "OpenRigsMazeRunnerTaskLogic",
      "type": "object"
    },
    "OpenRigsMazeRunnerTaskParameters": {
      "properties": {
        "rngSeed": {
          "default": null,
          "description": "Seed of the random number generator for these task parameters",
          "title": "RngSeed",
          "type": [
            "number",
            "null"
          ]
        },
        "rewardSequence": {
          "items": {
            "$ref": "#/$defs/RewardZone"
          },
          "title": "RewardSequence",
          "type": "array"
        }
      },
      "required": [
        "rewardSequence"
      ],
      "title": "OpenRigsMazeRunnerTaskParameters",
      "type": "object"
    },
    "RewardZone": {
      "properties": {
        "region": {
          "items": {
            "$ref": "#/$defs/Vector2"
          },
          "title": "Region",
          "type": "array"
        },
        "rewardCommand": {
          "title": "RewardCommand",
          "type": "string"
        }
      },
      "required": [
        "region",
        "rewardCommand"
      ],
      "title": "RewardZone",
      "type": "object"
    },
    "SpinnakerCamera": {
      "properties": {
        "triggerFrequency": {
          "default": 50,
          "description": "The frequency at which the camera is triggered (in Hz).",
          "minimum": 1,
          "title": "TriggerFrequency",
          "type": "number"
        },
        "exposureTime": {
          "default": 15000,
          "description": "The exposure time for the camera (in microseconds).",
          "minimum": 0,
          "title": "ExposureTime",
          "type": "number"
        },
        "serialNumber": {
          "default": "00000",
          "description": "The serial number of the camera.",
          "title": "SerialNumber",
          "type": [
            "string",
            "null"
          ]
        },
        "gain": {
          "default": 1,
          "description": "The camera gain.",
          "minimum": 0,
          "title": "Gain",
          "type": "number"
        },
        "binning": {
          "default": 1,
          "description": "The binning setting for the camera.",
          "minimum": 1,
          "title": "Binning",
          "type": "integer"
        },
        "discriminatorType": {
          "const": "SpinnakerCamera",
          "default": "SpinnakerCamera",
          "title": "DiscriminatorType",
          "type": "string"
        }
      },
      "title": "SpinnakerCamera",
      "type": "object"
    },
    "Vector2": {
      "properties": {
        "x": {
          "description": "X coordinate of the point.",
          "title": "X",
          "type": "number"
        },
        "y": {
          "description": "Y coordinate of the point.",
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "Vector2",
      "type": "object"
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/OpenRigsMazeRunnerTaskLogic"
    },
    {
      "$ref": "#/$defs/OpenRigsMazeRunnerRig"
    },
    {
      "$ref": "#/$defs/ExperimentSession"
    }
  ],
  "title": "RootModel[Union[OpenRigsMazeRunnerTaskLogic, OpenRigsMazeRunnerRig, ExperimentSession]]"
}